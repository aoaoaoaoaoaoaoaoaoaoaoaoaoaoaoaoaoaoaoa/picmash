digraph UnifiedQualityModelV2 {
  graph [
    rankdir=TB,
    pad=0.28,
    nodesep=0.30,
    ranksep=0.44,
    splines=ortho,
    newrank=true,
    compound=true,
    remincross=true,
    mclimit=100,
    fontname="Helvetica",
    labelloc="t",
    label="Unified Bayesian Quality Model"
  ];

  node [
    fontname="Helvetica",
    fontsize=11,
    margin="0.05,0.03",
    shape=ellipse,
    style="filled",
    fillcolor="white",
    color="black"
  ];

  edge [
    color="black",
    arrowsize=0.8,
    fontname="Helvetica"
  ];

  subject_plate_label [label="subject plate  u", shape=plain];
  asset_plate_label [label="asset plate  i", shape=plain];
  session_plate_label [label="session plate  s", shape=plain];
  memory_plate_label [label="memory plate  (i, s)", shape=plain];
  face_duel_plate_label [label="subject beauty duel plate  (u, v)", shape=plain];
  asset_duel_plate_label [label="asset duel plate  (i, j, s)", shape=plain];
  unary_plate_label [label="unary feedback plate  (i, s)", shape=plain];

  subgraph cluster_subject {
    label="";
    style="filled";
    color="black";
    penwidth=1.0;
    fillcolor="#fafafa";

    xbar_u [label="x̄_u", shape=box, fillcolor="#bdbdbd"];
    b_u [label="b_u"];

    xbar_u -> b_u;
  }

  subgraph cluster_asset {
    label="";
    style="filled";
    color="black";
    penwidth=1.0;
    fillcolor="#fafafa";

    x_i [label="x_i", shape=box, fillcolor="#bdbdbd"];
    tau_i [label="τ_i", shape=box, fillcolor="#bdbdbd"];
    v_i [label="v_i", shape=box, fillcolor="#bdbdbd"];
    delta_i [label="δ_i", shape=box, fillcolor="#bdbdbd"];

    c_i [label="c_i", fillcolor="#d9d9d9"];
    g_i [label="g_i", fillcolor="#d9d9d9"];
    h_i [label="h_i", fillcolor="#d9d9d9"];

    a_i [label="a_i"];
    kappa_i [label="κ_i"];
    q0_i [label="Q0_i", fillcolor="#d9d9d9"];

    x_i -> c_i;
    c_i -> h_i;
    v_i -> h_i;
    delta_i -> h_i;

    b_u -> g_i;
    g_i -> q0_i;

    tau_i -> kappa_i;
    a_i -> q0_i;
    kappa_i -> q0_i;
    delta_i -> q0_i;
  }

  subgraph cluster_session {
    label="";
    style="filled";
    color="black";
    penwidth=1.0;
    fillcolor="#fafafa";

    rho_s [label="ρ_s"];
    w_s [label="w_s"];
    lambda_s [label="λ_s", fillcolor="#d9d9d9"];
    t_s [label="T_s"];

    rho_s -> lambda_s;
  }

  subgraph cluster_memory {
    label="";
    style="filled";
    color="black";
    penwidth=1.0;
    fillcolor="#fafafa";

    eta_is [label="η_is"];
  }

  perturb_is [label="p_is", fillcolor="#d9d9d9"];
  u_is [label="U_is", fillcolor="#d9d9d9"];

  h_i -> perturb_is;
  w_s -> perturb_is;
  lambda_s -> perturb_is;

  q0_i -> u_is;
  perturb_is -> u_is;
  eta_is -> u_is;

  {
    rank=same;
    xbar_u;
    x_i;
    tau_i;
    v_i;
    delta_i;
    rho_s;
    w_s;
  }

  {
    rank=same;
    b_u;
    c_i;
    a_i;
    kappa_i;
    lambda_s;
    t_s;
    eta_is;
  }

  {
    rank=same;
    g_i;
    h_i;
    q0_i;
    perturb_is;
  }

  subgraph cluster_face_duel {
    label="";
    style="filled";
    color="black";
    penwidth=1.0;
    fillcolor="#fafafa";

    delta_face [label="Δ_face", fillcolor="#d9d9d9"];
    y_face [label="y_face", shape=box, fillcolor="#bdbdbd"];

    delta_face -> y_face;
  }

  subgraph cluster_asset_duel {
    label="";
    style="filled";
    color="black";
    penwidth=1.0;
    fillcolor="#fafafa";

    delta_asset [label="Δ_asset", fillcolor="#d9d9d9"];
    y_asset [label="y_asset", shape=box, fillcolor="#bdbdbd"];

    delta_asset -> y_asset;
  }

  subgraph cluster_unary {
    label="";
    style="filled";
    color="black";
    penwidth=1.0;
    fillcolor="#fafafa";

    r_is [label="r_is", shape=box, fillcolor="#bdbdbd"];
  }

  b_u -> delta_face;
  u_is -> delta_asset;
  u_is -> r_is;
  t_s -> r_is;

  subject_plate_label -> xbar_u [style=invis, weight=20];
  asset_plate_label -> x_i [style=invis, weight=20];
  session_plate_label -> rho_s [style=invis, weight=20];
  memory_plate_label -> eta_is [style=invis, weight=20];
  face_duel_plate_label -> delta_face [style=invis, weight=20];
  asset_duel_plate_label -> delta_asset [style=invis, weight=20];
  unary_plate_label -> r_is [style=invis, weight=20];
}
